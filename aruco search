import os
import cv2
import cv2.aruco as aruco
import numpy as np

# ---------------- CONFIG ----------------
# Same IDs and names as the detection script
MARKERS = {
    23: "prince",
    24: "aryan",
    25: "somyashree",
    26: "subasmita",
}

MARKER_PX = 600      # black square size in pixels
BORDER_PX = 100      # white border around the marker (needed for detection)
LABEL_PX = 120       # white strip below the marker for the name
OUTPUT_DIR = "aruco_markers"
# ----------------------------------------

os.makedirs(OUTPUT_DIR, exist_ok=True)

# Must match the dictionary used in the detection script
dictionary = aruco.getPredefinedDictionary(aruco.DICT_4X4_50)

for marker_id, name in MARKERS.items():

    # 1. Generate the marker (black/white square)
    marker = aruco.generateImageMarker(dictionary, marker_id, MARKER_PX)

    # 2. Add the white border all around
    marker = cv2.copyMakeBorder(
        marker, BORDER_PX, BORDER_PX, BORDER_PX, BORDER_PX,
        cv2.BORDER_CONSTANT, value=255
    )

    # 3. Add a white strip at the bottom and write the name on it
    #    (the name is only a human-readable label, outside the black square)
    label_strip = np.full((LABEL_PX, marker.shape[1]), 255, dtype=np.uint8)
    text = f"{name.capitalize()} (ID {marker_id})"

    (tw, th), _ = cv2.getTextSize(text, cv2.FONT_HERSHEY_SIMPLEX, 1.6, 3)
    tx = (label_strip.shape[1] - tw) // 2
    ty = (LABEL_PX + th) // 2
    cv2.putText(label_strip, text, (tx, ty),
                cv2.FONT_HERSHEY_SIMPLEX, 1.6, 0, 3)

    final = np.vstack([marker, label_strip])

    path = os.path.join(OUTPUT_DIR, f"marker_{marker_id}_{name}.png")
    cv2.imwrite(path, final)
    print("Saved:", path)

print("Done. Print the images and measure the BLACK square with a ruler.")